rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'kkiransenapati@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // 1. Produce Items Catalog (Public Read, Admin Write)
    match /produce_items/{produceId} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow initial seeding if not signed in, or admin
    }

    // 2. Orders & Escrow
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        // Escrow status release or review rating update
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['escrowStatus', 'rating', 'reviewComment', 'ratedAt'])
      );
      allow delete: if isAdmin();
    }

    // 3. Farm Clusters
    match /farm_clusters/{clusterId} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn();
    }

    // 4. Farmer Dispatches (Harvest to Reefer Lots)
    match /farmer_dispatches/{dispatchId} {
      allow read: if true;
      allow create: if isValidId(dispatchId) &&
        request.resource.data.crop is string &&
        request.resource.data.crates is number;
      allow update: if isValidId(dispatchId) && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'escrowSettled', 'vanAssigned', 'crates', 'weightKg'])
      );
      allow delete: if isAdmin();
    }

    // 5. Fleet Telemetry (Cold-Chain Refrigerated Vans)
    match /fleet_telemetry/{vanNumber} {
      allow read: if true;
      allow create, update: if isValidId(vanNumber) &&
        request.resource.data.currentTempCelsius is number &&
        request.resource.data.status is string;
      allow delete: if isAdmin();
    }

    // 6. Support Tickets (Customer Executive Dispute Center)
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if isValidId(ticketId) &&
        request.resource.data.orderId is string;
      allow update: if isValidId(ticketId) && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'priority'])
      );
      allow delete: if isAdmin();
    }

    // 7. Users (Private Profiles & Escrow Balances)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
